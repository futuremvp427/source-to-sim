  "functions": [
    {
      "schema": "public",
      "name": "get_pending_experiment_source_events",
      "identity_args": "uuid, integer",
      "security_definer": true,
      "config_contains": ["search_path=public"],
      "definition_contains": ["from public.paper_experiments", "join public.source_events", "from public.experiment_event_state", "source_event_id = se.id"],
      "execute_allowed": ["service_role"],
      "execute_denied": ["PUBLIC", "anon", "authenticated"]
    },
    {
      "schema": "public",
      "name": "get_experiment_source_positions",
      "identity_args": "uuid, text[]",
      "security_definer": true,
      "config_contains": ["search_path=public"],
      "definition_contains": ["from public.experiment_source_position_state", "experiment_id = p_experiment_id"],
      "execute_allowed": ["service_role"],
      "execute_denied": ["PUBLIC", "anon", "authenticated"]
    },
    {
      "schema": "public",
      "name": "process_source_event_atomic",
      "identity_args": "text, text, integer, uuid, jsonb",
      "security_definer": true,
      "config_contains": ["search_path=public"],
      "definition_contains": ["from public.worker_status", "insert into public.experiment_event_state", "on conflict (experiment_id, source_event_id) do nothing", "insert into public.experiment_source_position_state", "on conflict (experiment_id, event_key) do nothing"],
      "execute_allowed": ["service_role"],
      "execute_denied": ["PUBLIC", "anon", "authenticated"]
    },
    {
      "schema": "public",
      "name": "apply_verified_paper_settlement",
      "identity_args": "uuid, text, text, text, text, timestamp with time zone, numeric, jsonb, numeric, timestamp with time zone, integer, text",
      "security_definer": true,
      "config_contains": ["search_path=public"],
      "definition_contains": [
        "on conflict (experiment_id, asset) do nothing",
        "update public.paper_positions as pp",
        "update public.paper_experiments as pe",
        "insert into public.paper_trades",
        "'settlement:' || p_asset",
        "on conflict (experiment_id, event_key) do nothing",
        "slippage_basis_cents",
        "slippage_sample_cutoff_at",
        "slippage_sample_count",
        "slippage_method_version"
      ],
      "execute_allowed": ["service_role"],
      "execute_denied": ["PUBLIC", "anon", "authenticated"]
    },
    {
      "schema": "public",
      "name": "acquire_worker_lease",
      "identity_args": "text, text, integer",
      "security_definer": true,
      "config_contains": ["search_path=public"],
      "definition_contains": ["public.worker_status.lease_expires_at <= now()", "public.worker_status.fence + 1"],
      "execute_allowed": ["service_role"],
      "execute_denied": ["PUBLIC", "anon", "authenticated"]
    },
    {
      "schema": "public",
      "name": "has_role",
      "identity_args": "uuid, public.app_role",
      "security_definer": true,
      "config_contains": ["search_path=public"],
      "definition_contains": ["from public.user_roles", "user_id = _user_id", "role = _role"],
      "execute_allowed": ["authenticated", "service_role"],
      "execute_denied": ["PUBLIC", "anon"]
    },
    {
      "schema": "public",
      "name": "create_or_get_live_pilot_intent_atomic",
      "identity_args": "text, uuid, uuid, jsonb",
      "security_definer": true,
      "config_contains": ["search_path=public"],
      "definition_contains": [
        "insert into public.live_order_intents",
        "on conflict (source_experiment_id, source_event_id) do nothing",
        "select id, status into v_id, v_status",
        "from public.live_order_intents"
      ],
      "execute_allowed": ["service_role"],
      "execute_denied": ["PUBLIC", "anon", "authenticated"]
    },
    {
      "schema": "public",
      "name": "update_live_pilot_intent_status_atomic",
      "identity_args": "uuid, text, jsonb",
      "security_definer": true,
      "config_contains": ["search_path=public"],
      "definition_contains": [
        "select * into v_row from public.live_order_intents where id = p_intent_id for update",
        "update public.live_order_intents",
        "status_history = status_history || jsonb_build_object",
        "raise exception 'invalid status %'"
      ],
      "execute_allowed": ["service_role"],
      "execute_denied": ["PUBLIC", "anon", "authenticated"]
    }
  ],
